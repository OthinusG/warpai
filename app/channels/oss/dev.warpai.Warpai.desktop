[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Warpai
GenericName=TerminalEmulator

Exec=warpai %U
StartupWMClass=dev.warpai.Warpai

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.warpai.Warpai

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for Warpai URLs.
MimeType=x-scheme-handler/warpai;
